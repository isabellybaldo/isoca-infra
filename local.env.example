# Copy to local.env (git-ignored) and fill in. Never commit the real values.
# Public address of the box.
VPS_IP=203.0.113.10
# Port sshd listens on.
SSH_PORT=2222
# Your admin login on the box.
ADMIN=you
# Private key the deploy role uses (GitHub Actions holds the same key as a secret).
DEPLOY_KEY_PATH=~/.ssh/isoca_deploy
# Private key the claude role uses.
CLAUDE_KEY_PATH=~/.ssh/isoca_claude
