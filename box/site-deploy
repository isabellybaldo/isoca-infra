#!/usr/bin/env bash
# site-deploy: the only thing the deploy key can run.
#
# sshd forces this script (authorized_keys: command=, restrict) as the
# unprivileged `deploy` user. The client's command arrives in
# SSH_ORIGINAL_COMMAND and a tar.gz arrives on stdin. Both are hostile.
#
#   deploy <site> <release>   unpack into releases/<release>, point `current` at it
#   rollback <site>           point `current` at the newest older release
#   edge-config               replace the Traefik dynamic config files
#
# A second key forces `site-deploy --only-play` and can run these two and nothing
# else; the first key is refused them, so a service's key is its only way in:
#
#   release play sha256:<64 hex>   name the image digest play should run
#   rollback play                  name the digest it ran before
#
# Both only write PLAY_STATE/desired-image. Root's box/play-apply does the rest, so
# "released" means handed over, and the caller's smoke check says whether it came up.
#
# Refusals exit 2 with "refused: <reason>" on stderr and change nothing.
# Internal failures exit 1 and never print a success line.
#
# SITES_ROOT, EDGE_DYNAMIC, EDGE_INCOMING, PLAY_STATE, MAX_BYTES, KEEP and LOCK_WAIT are
# overridable so the tests can run in a temp dir. A client cannot set them:
# sshd only passes environment variables the server allows (AcceptEnv, and
# PermitUserEnvironment, which is off by default; keep both unset), so the
# client controls SSH_ORIGINAL_COMMAND and stdin and nothing else.
set -Eeuo pipefail
umask 022
export LC_ALL=C # byte-wise sorting and matching; release ids sort by time
unset TAR_OPTIONS GZIP # defence in depth: no option injection into tar or gzip

SITES_ROOT=${SITES_ROOT:-/srv/sites}
EDGE_DYNAMIC=${EDGE_DYNAMIC:-/srv/edge/dynamic}
# Edge uploads are staged here, not beside EDGE_DYNAMIC, so /srv/edge can stay
# root-owned. Same filesystem as EDGE_DYNAMIC, or the renames are not atomic.
EDGE_INCOMING=${EDGE_INCOMING:-/srv/edge/.incoming}
PLAY_STATE=${PLAY_STATE:-/srv/play/state}
MAX_BYTES=${MAX_BYTES:-209715200}
KEEP=${KEEP:-5}
LOCK_WAIT=${LOCK_WAIT:-600} # seconds a second deploy waits for the first
LIST_MAX=8388608            # most bytes of tar listing we will hold
NAME_MAX=3500               # longest entry name we accept (leaves room below PATH_MAX)
COMPONENT_MAX=255           # longest single path component (NAME_MAX of the filesystem)
TAR_VMEM_KB=524288          # address-space limit for tar: its memory is not otherwise bounded
STALE_MIN=120               # minutes before an abandoned upload dir is swept

SITE_RE='^[a-z0-9-]{1,32}$'
RELEASE_RE='^[0-9]{8}T[0-9]{6}Z-[0-9a-f]{7,40}$'
# No leading dot: the `*.yml` glob below would silently skip such a file.
EDGE_NAME_RE='^[A-Za-z0-9_-][A-Za-z0-9._-]*\.yml$'
PLAY_DIGEST_RE='^sha256:[0-9a-f]{64}$'
# A `tar -tv --numeric-owner` line: perms, uid/gid, size, ...
LIST_RE='^.{10} [0-9]+/[0-9]+ +([0-9]{1,15}) '

# Temp paths to remove on every exit path; set as they are created.
spool_dir='' work_dir='' made_dir='' lock_fd='' play_tmp=''

# rm_tree <path>: remove a tree even if an archive gave it mode 000.
rm_tree() {
  if [ -e "$1" ]; then
    chmod -R u+rwX -- "$1" 2>/dev/null || true
    rm -rf -- "$1"
  fi
}

cleanup() {
  [ -z "$spool_dir" ] || rm_tree "$spool_dir"
  [ -z "$work_dir" ] || rm_tree "$work_dir"
  [ -z "$made_dir" ] || rmdir -- "$made_dir" 2>/dev/null || true # releases/ we created for a refused deploy
  [ -z "$play_tmp" ] || rm -f -- "$play_tmp"
}
trap cleanup EXIT
trap 'echo "error: internal failure (line $LINENO)" >&2; exit 1' ERR

# Fixed reasons only: never put client-supplied bytes in a message.
refuse() {
  echo "refused: $1" >&2
  exit 2
}

# These come from the environment (tests) or defaults; guard anyway.
[[ "$MAX_BYTES" =~ ^[1-9][0-9]{0,15}$ ]] || { echo "error: bad MAX_BYTES" >&2; exit 1; }
[[ "$KEEP" =~ ^[1-9][0-9]{0,3}$ ]] || { echo "error: bad KEEP" >&2; exit 1; }
[[ "$LOCK_WAIT" =~ ^[0-9]{1,5}$ ]] || { echo "error: bad LOCK_WAIT" >&2; exit 1; }

# ---------------------------------------------------------------------------
# Reading and checking the upload
# ---------------------------------------------------------------------------

# spool <dir>: stdin -> $spool_dir/tar (a plain tar), under <dir> so it shares
# a filesystem with the target. Both the compressed and the uncompressed size
# are capped while reading, so a gzip bomb never reaches the disk in full.
# This runs before any lock: a slow upload must not block other deploys.
spool() {
  local dir=$1 size gz_rc=0
  spool_dir=$(mktemp -d -p "$dir" .upload.XXXXXX)

  head -c "$((MAX_BYTES + 1))" >"$spool_dir/gz"
  size=$(wc -c <"$spool_dir/gz")
  [ "$size" -le "$MAX_BYTES" ] || refuse "upload too large"

  gzip -dc <"$spool_dir/gz" 2>/dev/null | head -c "$((MAX_BYTES + 1))" >"$spool_dir/tar" || gz_rc=$?
  size=$(wc -c <"$spool_dir/tar")
  # Over the cap, gzip may have died of SIGPIPE: that is the size refusal, not damage.
  [ "$size" -le "$MAX_BYTES" ] || refuse "archive too large when unpacked"
  # Within the cap head read to EOF, so a gzip failure means truncated or corrupt.
  [ "$gz_rc" -eq 0 ] || refuse "not a complete gzip stream"
  rm -f -- "$spool_dir/gz"
}

# Every tar below reads the plain tar from stdin (`-f -`): given a file name
# GNU tar auto-detects compression, so a gzip inside the gzip would be
# unpacked past the size cap. From a pipe it refuses compressed input.

# limit_mem: cap the address space of the tar about to run (it allocates a
# client-chosen long name in full). If the limit cannot be set because a lower
# one is already in force, that one is good enough.
limit_mem() {
  ulimit -v "$TAR_VMEM_KB" 2>/dev/null || [ "$(ulimit -v)" -le "$TAR_VMEM_KB" ] 2>/dev/null
}

# list_to <out> <tar flags>: a listing, cut off at LIST_MAX while it streams
# (a hostile entry can make the listing far bigger than the archive).
list_to() {
  local out=$1 rc=0
  shift
  (limit_mem && exec tar --numeric-owner --quoting-style=escape "$@" -f - <"$spool_dir/tar" 2>/dev/null) |
    head -c "$((LIST_MAX + 1))" >"$out" || rc=$?
  [ "$(wc -c <"$out")" -le "$LIST_MAX" ] || refuse "archive listing too large"
  [ "$rc" -eq 0 ] || refuse "unreadable archive"
}

# check_archive <deploy|edge>: judge the archive from its listing, before
# anything is unpacked. Sets nfiles.
#   - `tar -tv` gives the type (first char of each line) and the size, `tar -t`
#     gives the names; both use escape quoting, so a newline in a name is "\n"
#     and cannot forge a line. The two lists must line up one to one.
#   - only regular files (-) and directories (d) pass: no links, devices, FIFOs.
#   - the sizes must add up to at most MAX_BYTES (sparse files list their full
#     size, so a 139-byte upload cannot unpack to 2 GB).
check_archive() {
  local mode=$1 total=0 size i type name part
  local -a vlines=() nlines=() parts=()
  list_to "$spool_dir/verbose" -tv
  list_to "$spool_dir/names" -t
  mapfile -t vlines <"$spool_dir/verbose"
  mapfile -t nlines <"$spool_dir/names"
  [ "${#vlines[@]}" -eq "${#nlines[@]}" ] || refuse "archive listing is inconsistent"

  nfiles=0
  for i in "${!nlines[@]}"; do
    type=${vlines[i]:0:1}
    name=${nlines[i]}
    case $type in
      - | d) ;;
      *) refuse "archive holds an entry that is not a file or directory" ;;
    esac
    [[ "${vlines[i]}" =~ $LIST_RE ]] || refuse "unreadable archive listing"
    size=${BASH_REMATCH[1]}
    total=$((total + 10#$size))
    [ "$total" -le "$MAX_BYTES" ] || refuse "archive too large when unpacked"

    [ "${#name}" -le "$NAME_MAX" ] || refuse "entry name too long"
    # Escape quoting shows control bytes as \n, \t, \033, \177 ...: no site needs them.
    [[ "$name" =~ \\([abfnrtv]|0[0-3][0-7]|177) ]] && refuse "control character in an entry name"
    IFS=/ read -ra parts <<<"$name"
    for part in "${parts[@]}"; do
      [ "${#part}" -le "$COMPONENT_MAX" ] || refuse "path component too long"
    done
    [ -n "$name" ] || refuse "entry with an empty name"
    [[ "$name" != /* ]] || refuse "absolute path in archive"
    # Wrapped in slashes so `..` is caught first, last, alone or in the middle.
    [[ "/$name/" != */../* ]] || refuse "path with .. in archive"

    if [ "$type" = d ]; then
      [ "$mode" = deploy ] || [ "$name" = ./ ] || refuse "directory in edge config"
      continue
    fi
    [[ "$name" != */ ]] || refuse "file entry named like a directory"
    [[ "/$name" != */. ]] || refuse "file entry named ."
    if [ "$mode" = edge ]; then
      # Top level only, and `./x.yml` is how `tar -C dir .` writes it.
      [[ "${name#./}" =~ $EDGE_NAME_RE ]] || refuse "edge config holds a name that is not a plain .yml"
    fi
    nfiles=$((nfiles + 1))
  done
  [ "$nfiles" -gt 0 ] || refuse "archive holds no files"
}

# unpack <dir>: extract into the existing dir as 0644/0755, nobody's
# ownership. --no-same-permissions still honours a 000 entry, so chmod after.
# tar, chmod and find print client-chosen names on error, so their stderr is
# dropped and any failure becomes one fixed refusal. The listing's sizes can
# be forged (a pax sparse header can list 10 bytes for a 1 TiB hole), so the
# unpacked tree is measured here, before the caller renames it into place.
unpack() {
  local dir=$1 total
  (limit_mem && exec tar --no-same-owner --no-same-permissions -xf - -C "$dir" <"$spool_dir/tar" 2>/dev/null) ||
    refuse "archive cannot be unpacked"
  chmod -R u+rwX -- "$dir" 2>/dev/null || refuse "archive cannot be unpacked" # a 000 dir would block find
  total=$(find "$dir" -type f -printf '%s\n' 2>/dev/null | awk '{s += $1} END {printf "%.0f", s}') ||
    refuse "archive cannot be unpacked"
  [ "$total" -le "$MAX_BYTES" ] || refuse "archive too large when unpacked"
  find "$dir" -type d -exec chmod 755 {} + 2>/dev/null || refuse "archive cannot be unpacked"
  find "$dir" -type f -exec chmod 644 {} + 2>/dev/null || refuse "archive cannot be unpacked"
}

# ---------------------------------------------------------------------------
# Locking: one writer at a time per site (and one for edge-config). Taken
# after the upload is read and checked, held until exit. A second deploy waits
# for the first (up to LOCK_WAIT seconds) instead of failing. The lock is on
# the directory itself, so no lock file is left behind.
# ---------------------------------------------------------------------------

lock() {
  local rc=0
  exec {lock_fd}<"$1"
  flock -w "$LOCK_WAIT" -E 200 "$lock_fd" || rc=$?
  [ "$rc" -ne 200 ] || refuse "another deploy is still running"
  [ "$rc" -eq 0 ] # any other flock failure is an internal error
}

# sweep_uploads <dir>: under the lock, drop upload dirs a killed run left.
# Uploads are spooled outside the lock, so only old ones count as abandoned.
sweep_uploads() {
  local d
  while IFS= read -r -d '' d; do
    rm_tree "$d"
  done < <(find "$1" -maxdepth 1 -type d -name '.upload.*' -mmin "+$STALE_MIN" -print0)
}

# ---------------------------------------------------------------------------
# Releases
# ---------------------------------------------------------------------------

# release_ids <site_dir>: release ids on disk, oldest first, one per line.
release_ids() {
  local d id
  for d in "$1"/releases/*; do
    id=${d##*/}
    [[ "$id" =~ $RELEASE_RE ]] && [ -d "$d" ] && [ ! -L "$d" ] && echo "$id"
  done
  return 0
}

# current_id <site_dir>: the release id `current` names; empty if none/odd.
current_id() {
  local target
  target=$(readlink "$1/current" 2>/dev/null) || return 0
  [[ "$target" == releases/* ]] || return 0
  [[ "${target#releases/}" =~ $RELEASE_RE ]] && echo "${target#releases/}"
  return 0
}

# switch_to <site_dir> <release>: relative symlink, replaced by one rename.
switch_to() {
  ln -sfn "releases/$2" "$1/current.new"
  mv -T "$1/current.new" "$1/current"
}

# prune <site_dir>: keep the newest KEEP releases and whatever current names.
prune() {
  local site_dir=$1 cur id count=0
  cur=$(current_id "$site_dir")
  while read -r id; do
    count=$((count + 1))
    [ "$count" -gt "$KEEP" ] || continue
    [ "$id" != "$cur" ] || continue
    rm_tree "${site_dir:?}/releases/$id"
  done < <(release_ids "$site_dir" | sort -r)
}

valid_site() {
  [[ "$1" =~ $SITE_RE ]] || refuse "bad site name"
  if [ ! -d "$SITES_ROOT/$1" ] || [ -L "$SITES_ROOT/$1" ]; then refuse "unknown site"; fi
}

release_exists() { [ -e "$1/releases/$2" ] || [ -L "$1/releases/$2" ]; }

cmd_deploy() {
  local site=$1 release=$2 site_dir t
  valid_site "$site"
  [[ "$release" =~ $RELEASE_RE ]] || refuse "bad release id"
  site_dir=$SITES_ROOT/$site
  release_exists "$site_dir" "$release" && refuse "release already exists"

  spool "$site_dir"
  check_archive deploy

  # From here on we write. Everything under the lock is ours alone, so a
  # releases/*.tmp found now was left by a killed run and can go.
  lock "$site_dir"
  sweep_uploads "$site_dir"
  for t in "$site_dir"/releases/*.tmp; do
    [ ! -d "$t" ] || rm_tree "$t"
  done
  release_exists "$site_dir" "$release" && refuse "release already exists"

  if [ ! -d "$site_dir/releases" ]; then
    mkdir "$site_dir/releases"
    made_dir=$site_dir/releases # undone if this deploy is refused later
  fi
  work_dir="$site_dir/releases/$release.tmp"
  mkdir "$work_dir"
  unpack "$work_dir"
  mv -T "$work_dir" "$site_dir/releases/$release"
  work_dir='' made_dir=''

  switch_to "$site_dir" "$release"
  prune "$site_dir"
  echo "deployed $site $release"
}

cmd_rollback() {
  local site=$1 site_dir cur id prev=''
  valid_site "$site"
  site_dir=$SITES_ROOT/$site
  lock "$site_dir"
  [ -L "$site_dir/current" ] || refuse "no current release"
  cur=$(current_id "$site_dir")
  [ -n "$cur" ] || refuse "current is not a release link"

  while read -r id; do
    [[ "$id" < "$cur" ]] && prev=$id
  done < <(release_ids "$site_dir") # oldest first, so the last hit is the newest older one
  [ -n "$prev" ] || refuse "no older release"

  switch_to "$site_dir" "$prev"
  echo "rolled back $site to $prev"
}

# ---------------------------------------------------------------------------
# Edge config
# ---------------------------------------------------------------------------

# Traefik watches EDGE_DYNAMIC, so nothing half-written may appear in it.
# Unpack under EDGE_INCOMING (never inside the watched dir), then rename each
# file in (each rename is atomic), then drop the files the new set lacks.
cmd_edge_config() {
  local f base count=0 d
  local -A incoming=()
  if [ ! -d "$EDGE_DYNAMIC" ] || [ -L "$EDGE_DYNAMIC" ]; then refuse "no edge config directory"; fi
  if [ ! -d "$EDGE_INCOMING" ] || [ -L "$EDGE_INCOMING" ]; then refuse "no edge staging directory"; fi

  spool "$EDGE_INCOMING"
  check_archive edge

  lock "$EDGE_INCOMING"
  sweep_uploads "$EDGE_INCOMING"
  for d in "$EDGE_INCOMING"/new.*; do
    [ ! -d "$d" ] || rm_tree "$d" # only ever made under the lock: a killed run's
  done

  work_dir=$(mktemp -d -p "$EDGE_INCOMING" new.XXXXXX)
  unpack "$work_dir"

  for f in "$work_dir"/*.yml; do
    base=${f##*/}
    mv -T -- "$f" "$EDGE_DYNAMIC/$base"
    incoming[$base]=1
    count=$((count + 1))
  done
  for f in "$EDGE_DYNAMIC"/* "$EDGE_DYNAMIC"/.[!.]* "$EDGE_DYNAMIC"/..?*; do
    [ -e "$f" ] || [ -L "$f" ] || continue # an unmatched glob stays literal
    [ -n "${incoming[${f##*/}]-}" ] || rm -rf -- "$f"
  done
  echo "edge config $count files"
}

# ---------------------------------------------------------------------------
# Play: a digest for root's play-apply to pick up
# ---------------------------------------------------------------------------

# play_lock: one writer at a time on the state directory; play-apply takes this
# lock too before it restores desired-image after a failed release.
play_lock() {
  local f
  if [ ! -d "$PLAY_STATE" ] || [ -L "$PLAY_STATE" ]; then refuse "no play state directory"; fi
  lock "$PLAY_STATE"
  for f in "$PLAY_STATE"/.desired.*; do
    [ ! -f "$f" ] || rm -f -- "$f" # only ever made under the lock: a killed run's
  done
}

# write_desired <digest>: one rename, so play-apply never reads half a digest.
write_desired() {
  play_tmp=$(mktemp -p "$PLAY_STATE" .desired.XXXXXX)
  printf '%s\n' "$1" >"$play_tmp"
  chmod 644 -- "$play_tmp"
  mv -T -- "$play_tmp" "$PLAY_STATE/desired-image"
  play_tmp=''
}

cmd_release_play() {
  play_lock
  write_desired "$1"
  echo "released play $1"
}

# play-apply wrote previous-image, but the directory is ours and the rule is the
# same for every file in it: read only a plain file, and only a whole digest.
cmd_rollback_play() {
  local f=$PLAY_STATE/previous-image digest
  play_lock
  if [ ! -f "$f" ] || [ -L "$f" ]; then refuse "no previous play release"; fi
  digest=$(head -c 100 -- "$f")
  [[ "$digest" != *$'\n'* ]] && [[ "$digest" =~ $PLAY_DIGEST_RE ]] || refuse "previous play release is not a digest"
  write_desired "$digest"
  echo "rolled back play"
}

# ---------------------------------------------------------------------------
# Entry point: parse the command without eval or word splitting. Anchored
# regexes over the whole string, so extra arguments fail to match. A newline is
# rejected first because bash's $ would let one trail through.
# ---------------------------------------------------------------------------

main_only_play() {
  local cmd=${SSH_ORIGINAL_COMMAND-}
  [[ "$cmd" != *$'\n'* ]] || refuse "bad command"

  if [[ "$cmd" =~ ^release\ play\ (sha256:[0-9a-f]{64})$ ]]; then
    cmd_release_play "${BASH_REMATCH[1]}"
  elif [ "$cmd" = "rollback play" ]; then
    cmd_rollback_play
  else
    refuse "this key can only release and roll back play"
  fi
}

main() {
  local cmd=${SSH_ORIGINAL_COMMAND-}
  [[ "$cmd" != *$'\n'* ]] || refuse "bad command"

  # Checked before the verbs below, whatever SITES_ROOT holds.
  if [[ "$cmd" =~ ^release\  ]] || [ "$cmd" = "rollback play" ]; then
    refuse "play has its own key"
  fi

  if [[ "$cmd" =~ ^deploy\ ([^\ ]+)\ ([^\ ]+)$ ]]; then
    cmd_deploy "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}"
  elif [[ "$cmd" =~ ^rollback\ ([^\ ]+)$ ]]; then
    cmd_rollback "${BASH_REMATCH[1]}"
  elif [ "$cmd" = edge-config ]; then
    cmd_edge_config
  else
    refuse "unknown command"
  fi
}

# Arguments come from authorized_keys, never from the client. Anything but the one
# flag stops here: a typo in that file must not fall back to this key's full powers.
if [ "$#" -eq 1 ] && [ "$1" = --only-play ]; then
  main_only_play
elif [ "$#" -eq 0 ]; then
  main
else
  refuse "bad arguments"
fi
